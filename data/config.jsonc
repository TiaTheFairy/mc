  // QQ 群号（页面上展示用）
  "qqGroup": "未填写群号",

  // QQ 加群链接（主页"QQ交流群"卡片跳转用）
  "qqJoinLink": "https://qm.qq.com/q/JrzjiIuLWC",

  // 站点各处超链接地址
  "links": {
    // 服务器百科 / 文档
    "wiki": "https://wiki.mc.ttfl.net",
    // 服务器地图（为空字符串 "" 时点击会提示"该网站还未做解析呢"）
    "map": "https://map.mc.ttfl.net",
    // 个人主页
    "personalHomepage": "https://ttfl.net",
    // 相关链接下拉菜单
    "namemc": "https://namemc.com",
    "minecraft": "https://www.minecraft.net",
    // 主页"资讯"区
